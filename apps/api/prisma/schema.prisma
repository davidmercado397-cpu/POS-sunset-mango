// Esquema de datos del POS. Montos en COP como enteros; cantidades de inventario con 3 decimales.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Negocio (cliente del SaaS)
model Tenant {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  isActive         Boolean  @default(true)
  /// Subdominio de la tienda en línea: <storeSubdomain>.<PUBLIC_STORE_DOMAIN>
  storeSubdomain   String?  @unique
  /// Dominio propio opcional para la tienda (ej. pedidos.minegocio.com)
  storeDomain      String?  @unique
  /// Módulos que el Super Admin habilitó para este negocio (ver src/common/modules.ts)
  enabledModules   String[] @default([])
  // Marca
  brandName        String?
  logoUrl          String?
  primaryColor     String   @default("#f97316")
  secondaryColor   String   @default("#7c2d12")
  // Pasarela Bold (integración pendiente de activar)
  boldEnabled      Boolean  @default(false)
  boldIdentityKey  String?
  /// Llave secreta cifrada (AES-256-GCM); nunca se devuelve al navegador
  boldSecretKeyEnc String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  branches          Branch[]
  users             User[]
  roles             Role[]
  categories        Category[]
  products          Product[]
  expenseCategories ExpenseCategory[]
  inventoryItems    InventoryItem[]
  suppliers         Supplier[]
}

/// Sede / punto de venta
model Branch {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  address         String?
  phone           String?
  isActive        Boolean  @default(true)
  /// Módulos activos en la sede (subconjunto de Tenant.enabledModules)
  activeModules   String[] @default([])
  /// Consecutivo de ventas de la sede
  saleSeq         Int      @default(0)
  // Pedidos en línea
  onlineAccepting Boolean  @default(true)
  allowDelivery   Boolean  @default(true)
  allowPickup     Boolean  @default(true)
  deliveryFee     Int      @default(0)
  minOrder        Int      @default(0)
  onlineMessage   String?
  whatsapp        String?
  /// Datos para que el cliente pague por transferencia (banco, cuenta, Nequi…)
  transferInfo    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users        UserBranch[]
  cashSessions CashSession[]
  sales        Sale[]
  stocks       Stock[]
  tables       DiningTable[]
  onlineOrders OnlineOrder[]

  @@index([tenantId])
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  /// Claves de permiso (ver src/common/permissions.ts)
  permissions String[] @default([])
  /// Rol base creado por el sistema (no se puede borrar)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, name])
}

model User {
  id                  String    @id @default(uuid())
  /// null únicamente para el Super Admin de la plataforma
  tenantId            String?
  roleId              String?
  isSuperAdmin        Boolean   @default(false)
  fullName            String
  username            String    @unique
  email               String?
  passwordHash        String
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role          Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  branches      UserBranch[]
  refreshTokens RefreshToken[]
  cashOpened    CashSession[]  @relation("CashOpenedBy")
  cashClosed    CashSession[]  @relation("CashClosedBy")
  cashMovements CashMovement[]
  salesCreated  Sale[]         @relation("SaleCreatedBy")
  salesVoided   Sale[]         @relation("SaleVoidedBy")

  @@index([tenantId])
}

/// Sedes a las que tiene acceso un usuario
model UserBranch {
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

/// Refresh tokens rotativos; se guarda solo el hash
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  /// Todos los tokens de una misma sesión comparten familia; si se reutiliza uno revocado, se revoca la familia
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  branchId  String?
  userId    String?
  action    String
  entity    String?
  entityId  String?
  data      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ───────────────────────── Catálogo ─────────────────────────

model Category {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  color     String   @default("#f97316")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId])
}

model Product {
  id                String   @id @default(uuid())
  tenantId          String
  categoryId        String?
  name              String
  description       String?
  price             Int
  imageUrl          String?
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  /// Se envía a la pantalla de cocina al vender
  sendToKitchen     Boolean  @default(true)
  /// Sedes donde NO está disponible (vacío = todas)
  disabledBranchIds String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  modifierGroups ModifierGroup[]
  recipe         RecipeLine[]

  @@index([tenantId])
}

/// Grupo de variantes/adiciones de un producto (ej. "Tamaño", "Adiciones")
model ModifierGroup {
  id        String @id @default(uuid())
  productId String
  name      String
  minSelect Int    @default(0)
  maxSelect Int    @default(1)
  sortOrder Int    @default(0)

  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ModifierOption[]
}

model ModifierOption {
  id         String  @id @default(uuid())
  groupId    String
  name       String
  priceDelta Int     @default(0)
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  group  ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recipe RecipeLine[]
}

/// Componente de receta: pertenece a un producto o a una opción de variante
model RecipeLine {
  id               String  @id @default(uuid())
  productId        String?
  modifierOptionId String?
  inventoryItemId  String
  quantity         Decimal @db.Decimal(14, 3)

  product        Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierOption ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([modifierOptionId])
}

// ───────────────────────── Caja ─────────────────────────

enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashSession {
  id            String            @id @default(uuid())
  tenantId      String
  branchId      String
  status        CashSessionStatus @default(OPEN)
  openedById    String
  closedById    String?
  openedAt      DateTime          @default(now())
  closedAt      DateTime?
  openingAmount Int
  /// Conteo por denominación al abrir { "50000": 2, ... }
  openingCount  Json?
  closingCount  Json?
  /// Resumen calculado al cerrar: esperado, contado y diferencia por método
  summary       Json?
  notes         String?

  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  openedBy  User           @relation("CashOpenedBy", fields: [openedById], references: [id])
  closedBy  User?          @relation("CashClosedBy", fields: [closedById], references: [id])
  movements CashMovement[]
  sales     Sale[]

  @@index([tenantId, branchId, openedAt])
}

model ExpenseCategory {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements     CashMovement[]
  adminExpenses AdminExpense[]

  @@unique([tenantId, name])
}

enum CashMovementType {
  EXPENSE
  WITHDRAWAL
  DEPOSIT
}

model CashMovement {
  id          String           @id @default(uuid())
  tenantId    String
  branchId    String
  sessionId   String
  type        CashMovementType
  /// Gastos: efectivo de la caja o transferencia. Salidas y entradas siempre son en efectivo.
  method      PaymentMethod    @default(CASH)
  amount      Int
  categoryId  String?
  description String?
  createdById String
  createdAt   DateTime         @default(now())

  session   CashSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  category  ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User             @relation(fields: [createdById], references: [id])

  @@index([sessionId])
}

// ───────────────────────── Ventas ─────────────────────────

enum SaleStatus {
  OPEN
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH
  TRANSFER
  QR_BOLD
}

model Sale {
  id            String         @id @default(uuid())
  tenantId      String
  branchId      String
  cashSessionId String?
  number        Int
  status        SaleStatus     @default(COMPLETED)
  tableId       String?
  customerName  String?
  notes         String?
  subtotal      Int            @default(0)
  tipAmount     Int            @default(0)
  tipMethod     PaymentMethod?
  createdById   String
  createdAt     DateTime       @default(now())
  completedAt   DateTime?
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?

  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashSession    CashSession?    @relation(fields: [cashSessionId], references: [id])
  table          DiningTable?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  createdBy      User            @relation("SaleCreatedBy", fields: [createdById], references: [id])
  voidedBy       User?           @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  items          SaleItem[]
  payments       Payment[]
  kitchenTickets KitchenTicket[]

  @@unique([branchId, number])
  @@index([tenantId, branchId, createdAt])
  @@index([cashSessionId])
}

model SaleItem {
  id          String    @id @default(uuid())
  saleId      String
  productId   String?
  productName String
  /// Precio unitario con variantes incluidas
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  notes       String?
  /// Momento en que se envió a cocina (mesas)
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  sale      Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  modifiers SaleItemModifier[]

  @@index([saleId])
  @@index([productId])
}

model SaleItemModifier {
  id         String  @id @default(uuid())
  saleItemId String
  optionId   String?
  groupName  String
  optionName String
  priceDelta Int

  saleItem SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String        @id @default(uuid())
  saleId    String
  method    PaymentMethod
  /// Valor aplicado a la cuenta (incluye la propina si se pagó con este método)
  amount    Int
  /// Solo efectivo: dinero recibido y cambio entregado
  received  Int?
  change    Int?
  reference String?
  createdAt DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// ───────────────────────── Cocina y mesas ─────────────────────────

enum KitchenStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

model KitchenTicket {
  id            String        @id @default(uuid())
  tenantId      String
  branchId      String
  saleId        String?
  onlineOrderId String?
  status        KitchenStatus @default(PENDING)
  /// Copia de los ítems enviados [{ name, quantity, modifiers[], notes }]
  items         Json
  label         String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  sale        Sale?        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  onlineOrder OnlineOrder? @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)

  @@index([branchId, status])
}

model DiningTable {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  name      String
  area      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sales  Sale[]

  @@unique([branchId, name])
}

// ───────────────────────── Inventario ─────────────────────────

enum InventoryItemType {
  INGREDIENT
  PRODUCT
}

model InventoryItem {
  id        String            @id @default(uuid())
  tenantId  String
  name      String
  type      InventoryItemType @default(INGREDIENT)
  /// und, g, kg, ml, l, lb, oz
  unit      String            @default("und")
  minStock  Decimal           @default(0) @db.Decimal(14, 3)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stocks      Stock[]
  movements   StockMovement[]
  recipeLines RecipeLine[]

  @@unique([tenantId, name])
}

/// Existencias y costo promedio de un ítem en una sede
model Stock {
  itemId   String
  branchId String
  quantity Decimal @default(0) @db.Decimal(14, 3)
  avgCost  Decimal @default(0) @db.Decimal(14, 2)

  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branch Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([itemId, branchId])
}

enum StockMovementType {
  INITIAL
  PURCHASE
  SALE
  VOID
  ADJUSTMENT
  WASTE
  TRANSFER_OUT
  TRANSFER_IN
}

model StockMovement {
  id           String            @id @default(uuid())
  tenantId     String
  branchId     String
  itemId       String
  type         StockMovementType
  /// Positivo entra, negativo sale
  quantity     Decimal           @db.Decimal(14, 3)
  unitCost     Decimal           @default(0) @db.Decimal(14, 2)
  balanceAfter Decimal           @db.Decimal(14, 3)
  refType      String?
  refId        String?
  note         String?
  userId       String?
  createdAt    DateTime          @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, itemId, createdAt])
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  nit       String?
  phone     String?
  email     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@index([tenantId])
}

model Purchase {
  id            String   @id @default(uuid())
  tenantId      String
  branchId      String
  supplierId    String?
  invoiceNumber String?
  date          DateTime @default(now())
  total         Int
  notes         String?
  /// Si se pagó con efectivo de la caja abierta
  paidFromCash  Boolean  @default(false)
  createdById   String
  createdAt     DateTime @default(now())

  supplier Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items    PurchaseItem[]

  @@index([tenantId, branchId, date])
}

model PurchaseItem {
  id         String  @id @default(uuid())
  purchaseId String
  itemId     String
  quantity   Decimal @db.Decimal(14, 3)
  unitCost   Decimal @db.Decimal(14, 2)
  total      Int

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

enum TransferStatus {
  SENT
  RECEIVED
  CANCELLED
}

model Transfer {
  id           String         @id @default(uuid())
  tenantId     String
  fromBranchId String
  toBranchId   String
  status       TransferStatus @default(SENT)
  notes        String?
  createdById  String
  receivedById String?
  createdAt    DateTime       @default(now())
  receivedAt   DateTime?

  items TransferItem[]

  @@index([tenantId, createdAt])
}

model TransferItem {
  id         String  @id @default(uuid())
  transferId String
  itemId     String
  quantity   Decimal @db.Decimal(14, 3)
  unitCost   Decimal @default(0) @db.Decimal(14, 2)

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Pedidos en línea ─────────────────────────

enum OnlineOrderStatus {
  NEW
  ACCEPTED
  READY
  DISPATCHED
  COMPLETED
  REJECTED
  CANCELLED
}

enum OnlinePaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OnlineOrderType {
  DELIVERY
  PICKUP
}

/// Pedido hecho por un cliente desde el enlace público (sin usuario)
model OnlineOrder {
  id               String              @id @default(uuid())
  tenantId         String
  branchId         String
  /// Código corto para seguimiento público
  code             String              @unique
  status           OnlineOrderStatus   @default(NEW)
  type             OnlineOrderType
  customerName     String
  phone            String
  address          String?
  addressNotes     String?
  notes            String?
  /// Método con el que el cliente dice que pagará
  paymentMethod    PaymentMethod
  /// Efectivo: con cuánto paga (para llevar cambio)
  payWith          Int?
  paymentStatus    OnlinePaymentStatus @default(PENDING)
  /// Referencia del pago (transferencia o transacción de la pasarela)
  paymentReference String?
  /// Copia de los ítems con precios calculados en el servidor
  items            Json
  subtotal         Int
  deliveryFee      Int                 @default(0)
  total            Int
  rejectReason     String?
  /// Venta generada al cobrar
  saleId           String?             @unique
  ip               String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  kitchenTickets KitchenTicket[]

  @@index([branchId, status, createdAt])
}

/// Cierre mensual de una sede: consolida los cierres diarios del mes y guarda una copia fija.
model MonthlyClose {
  id         String   @id @default(uuid())
  tenantId   String
  branchId   String
  year       Int
  month      Int
  /// Copia del consolidado al momento del cierre
  summary    Json
  notes      String?
  closedById String
  closedAt   DateTime @default(now())

  @@unique([branchId, year, month])
  @@index([tenantId])
}

/// Gasto administrativo (arriendo, nómina, servicios…). No afecta la caja del día.
model AdminExpense {
  id          String        @id @default(uuid())
  tenantId    String
  /// null = gasto general del negocio (no de una sede)
  branchId    String?
  categoryId  String?
  description String
  amount      Int
  method      PaymentMethod @default(TRANSFER)
  /// Fecha del gasto (día contable)
  date        DateTime
  reference   String?
  receiptUrl  String?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
}
