// Esquema base (Fase 1). Las tablas de catálogo, caja, ventas e inventario
// se agregan en sus fases correspondientes.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Negocio (cliente del SaaS)
model Tenant {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  isActive       Boolean  @default(true)
  /// Módulos que el Super Admin habilitó para este negocio (ver src/common/modules.ts)
  enabledModules String[] @default([])
  // Marca
  brandName      String?
  logoUrl        String?
  primaryColor   String   @default("#f97316")
  secondaryColor String   @default("#7c2d12")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branches Branch[]
  users    User[]
  roles    Role[]
}

/// Sede / punto de venta
model Branch {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  address       String?
  phone         String?
  isActive      Boolean  @default(true)
  /// Módulos activos en la sede (subconjunto de Tenant.enabledModules)
  activeModules String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  UserBranch[]

  @@index([tenantId])
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  /// Claves de permiso (ver src/common/permissions.ts)
  permissions String[] @default([])
  /// Rol base creado por el sistema (no se puede borrar)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, name])
}

model User {
  id                  String    @id @default(uuid())
  /// null únicamente para el Super Admin de la plataforma
  tenantId            String?
  roleId              String?
  isSuperAdmin        Boolean   @default(false)
  fullName            String
  username            String    @unique
  email               String?
  passwordHash        String
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role          Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  branches      UserBranch[]
  refreshTokens RefreshToken[]

  @@index([tenantId])
}

/// Sedes a las que tiene acceso un usuario
model UserBranch {
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

/// Refresh tokens rotativos; se guarda solo el hash
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  /// Todos los tokens de una misma sesión comparten familia; si se reutiliza uno revocado, se revoca la familia
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  userAgent  String?
  ip         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  branchId  String?
  userId    String?
  action    String
  entity    String?
  entityId  String?
  data      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}
