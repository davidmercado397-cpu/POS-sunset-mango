# Copia este archivo a .env y cambia los valores antes de desplegar.

# --- Base de datos ---
POSTGRES_USER=pos
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=pos

# --- Aplicación ---
# Puerto local donde escuchará la app (el servidor web del VPS apunta aquí)
APP_PORT=3000
# Genera uno con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
# true en producción (el sitio se sirve por HTTPS desde el servidor web)
COOKIE_SECURE=true
# Número de proxies delante de la app (1 = solo el servidor web del VPS)
TRUST_PROXY=1
# Clave para cifrar llaves de pasarelas (opcional; por defecto usa JWT_ACCESS_SECRET)
ENCRYPTION_KEY=
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# --- Tienda en línea (pedidos) ---
# Dominio base de las tiendas: cada negocio queda en <subdominio>.<este dominio>
# Ej.: pedidos.tudominio.com -> sunsetmango.pedidos.tudominio.com (requiere DNS comodín y certificado comodín)
PUBLIC_STORE_DOMAIN=
# URL pública de la aplicación, para los enlaces /pedir/<negocio> cuando no hay dominio de tiendas
PUBLIC_APP_URL=

# --- Super Admin inicial ---
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME="Super Administrador"
